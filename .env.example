# Copy to .env (git-ignored). Everything here is also settable as a plain
# environment variable; see src/fleet/config.py for the full list.

# --- registry -----------------------------------------------------------
FLEET_DATABASE_URL=postgresql://fleet:fleet@localhost:5433/fleet
# Aurora: postgresql://fleet:<secret>@<writer-endpoint>:5432/fleet

# --- model / device -----------------------------------------------------
FLEET_TARGET_MODEL=Qwen/Qwen2.5-0.5B-Instruct
FLEET_DEVICE=cuda
FLEET_DTYPE=auto
# fp32 is bit-exact against greedy; fp16 is exact up to sub-ULP argmax ties.
# See README section 1.

# --- speculative decoding ----------------------------------------------
FLEET_GAMMA=4
FLEET_MAX_NEW_TOKENS=48

# --- rollout ------------------------------------------------------------
FLEET_CANARY_PCT=20
FLEET_CANARY_MIN_REQUESTS=60
FLEET_SLO_MIN_TPS_RATIO=0.98
FLEET_SLO_MAX_P95_RATIO=1.05
FLEET_SLO_REQUIRE_GREEDY_MATCH=true

# --- drift / training ---------------------------------------------------
FLEET_DRIFT_WINDOW=400
FLEET_DRIFT_THRESHOLD=0.15
FLEET_TRAIN_MIN_SAMPLES=200
FLEET_TRAIN_MAX_SAMPLES=6000
FLEET_AUDIT_SAMPLE_RATE=0.02
